// Prisma schema for CIRCLE. Sprint 1 scope: just enough to authenticate
// and identify a user's role. Later sprints extend this file — see
// docs/plan.md for the full model list and the reasoning behind each
// design choice (append-only audit trail, the AI-approval status enums).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  SUPPORT_PARTNER
  PROFESSIONAL_LEAD
  ORG_ADMIN
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  cohorts        Cohort[]
  safetyKeywords OrgSafetyKeyword[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org                     Organization             @relation(fields: [orgId], references: [id])
  memberProfile           MemberProfile?
  supportPartnerProfile   SupportPartnerProfile?
  professionalLeadProfile ProfessionalLeadProfile?
  authoredContextEntries  ContextLedgerEntry[]
  ownedActionItems        ActionItem[]

  @@index([orgId])
  @@map("users")
}

// A cohort is a Professional Lead's caseload of Members and Support
// Partners — the unit admins organize around and leads are scoped to.
model Cohort {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  leadId    String?  @unique @map("lead_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org             Organization             @relation(fields: [orgId], references: [id])
  lead            ProfessionalLeadProfile? @relation(fields: [leadId], references: [id])
  memberProfiles  MemberProfile[]
  supportPartners SupportPartnerProfile[]

  @@index([orgId])
  @@map("cohorts")
}

model MemberProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  cohortId     String?  @map("cohort_id")
  // Default visibility per ContextCategory, e.g. {"GOAL": "COHORT"} — what
  // a new entry's visibility pre-fills to. Config the Member controls
  // themselves, not a hardcoded default per category.
  sharingPrefs Json?    @map("sharing_prefs")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id])
  cohort           Cohort?              @relation(fields: [cohortId], references: [id])
  careCircle       CareCircle?
  contextEntries   ContextLedgerEntry[]
  interactions     Interaction[]
  actionItems      ActionItem[]
  aiInvocations    AIInvocationLog[]
  reviewQueueItems ReviewQueueItem[]

  @@index([cohortId])
  @@map("member_profiles")
}

model SupportPartnerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  cohortId    String?  @map("cohort_id")
  // Config-driven, not hardcoded: how many active Members this Partner
  // can carry at once, surfaced as "caseload / cap" on their dashboard.
  caseloadCap Int      @default(15) @map("caseload_cap")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id])
  cohort       Cohort?                @relation(fields: [cohortId], references: [id])
  memberships  CareCircleMembership[]
  interactions Interaction[]

  @@index([cohortId])
  @@map("support_partner_profiles")
}

model ProfessionalLeadProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id])
  cohort Cohort?

  @@map("professional_lead_profiles")
}

// One CareCircle per Member — the container that CareCircleMembership rows
// attach Support Partners to. Kept as its own model (rather than putting
// membership rows straight on MemberProfile) so "the circle" is a stable
// concept later features (Context Ledger visibility, Prep Card) can point
// to without caring which partners currently sit in it.
model CareCircle {
  id        String   @id @default(uuid())
  memberId  String   @unique @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member      MemberProfile          @relation(fields: [memberId], references: [id])
  memberships CareCircleMembership[]

  @@map("care_circles")
}

enum CareCircleRole {
  PRIMARY
  SECONDARY
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

// The routing join table: which Support Partner sits in which Member's
// circle, and in what capacity. "Exactly one ACTIVE PRIMARY per circle" is
// enforced here at the app level (see care-circle.ts) AND at the DB level
// via a partial unique index added by raw SQL in the migration — Prisma's
// schema DSL has no WHERE-clause index syntax, so it can't be expressed
// here directly.
model CareCircleMembership {
  id               String           @id @default(uuid())
  careCircleId     String           @map("care_circle_id")
  supportPartnerId String           @map("support_partner_id")
  roleInCircle     CareCircleRole   @map("role_in_circle")
  status           MembershipStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  careCircle     CareCircle            @relation(fields: [careCircleId], references: [id])
  supportPartner SupportPartnerProfile @relation(fields: [supportPartnerId], references: [id])

  @@index([careCircleId])
  @@index([supportPartnerId])
  @@map("care_circle_memberships")
}

enum ContextCategory {
  GOAL
  PREFERENCE
  NOTE
}

// Who can read an entry, in ascending order of reach. Chosen per entry at
// creation time (pre-filled from MemberProfile.sharingPrefs), not a fixed
// property of the category — a Member may have one GOAL they want their
// whole cohort to see and another they keep to their Circle only.
enum ContextVisibility {
  MEMBER_ONLY
  CIRCLE
  COHORT
  ORG
}

// Append-only by construction: "editing" an entry never updates its
// content — it creates a new row with supersedesId pointing at the old
// one, and flips the old row's isCurrent to false. The historical text is
// never destroyed, only superseded. See server/data/contextEntries.ts for
// the SessionScope + visibility filtering that decides who can read which
// rows.
model ContextLedgerEntry {
  id           String            @id @default(uuid())
  memberId     String            @map("member_id")
  category     ContextCategory
  content      String
  visibility   ContextVisibility @default(CIRCLE)
  createdById  String            @map("created_by_id")
  supersedesId String?           @unique @map("supersedes_id")
  isCurrent    Boolean           @default(true) @map("is_current")
  createdAt    DateTime          @default(now()) @map("created_at")

  member       MemberProfile       @relation(fields: [memberId], references: [id])
  createdBy    User                @relation(fields: [createdById], references: [id])
  supersedes   ContextLedgerEntry? @relation("EntryVersionChain", fields: [supersedesId], references: [id])
  supersededBy ContextLedgerEntry? @relation("EntryVersionChain")

  @@index([memberId, isCurrent])
  @@map("context_ledger_entries")
}

enum CaptureMethod {
  TYPED
  AUDIO_UPLOAD
}

// The AI-never-finalizes-anything boundary lives here: every summary and
// action item a Claude call produces starts PENDING_APPROVAL. Only
// approveCaptureAction (server/actions/interactions.ts, human-triggered,
// requireRole'd to SUPPORT_PARTNER) can move either to APPROVED — nothing
// in continuity-engine/* has the power to.
enum InteractionSummaryStatus {
  PENDING_APPROVAL
  APPROVED
}

enum ActionItemStatus {
  PENDING_APPROVAL
  APPROVED
}

enum AIInvocationPurpose {
  CAPTURE_SUMMARY
  PREP_DIGEST
  SURFACE_ANALYSIS
}

// A single Capture event between a Support Partner and a Member — the raw
// material (typed or transcribed) that a Claude call turns into a draft
// InteractionSummary + ActionItem[]. Retaining audioFilePath permanently
// (not deleting after transcription) is a deliberate product decision — see
// docs/plan.md "Audio File Storage" — so a Lead can re-listen if a capture
// is ever disputed.
model Interaction {
  id                        String        @id @default(uuid())
  memberId                  String        @map("member_id")
  supportPartnerId          String        @map("support_partner_id")
  occurredAt                DateTime      @default(now()) @map("occurred_at")
  captureMethod             CaptureMethod @default(TYPED) @map("capture_method")
  recordingConsentConfirmed Boolean       @default(false) @map("recording_consent_confirmed")
  audioFilePath             String?       @map("audio_file_path")
  rawNotes                  String?       @map("raw_notes")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  member           MemberProfile         @relation(fields: [memberId], references: [id])
  supportPartner   SupportPartnerProfile @relation(fields: [supportPartnerId], references: [id])
  summary          InteractionSummary?
  actionItems      ActionItem[]
  aiInvocations    AIInvocationLog[]
  reviewQueueItems ReviewQueueItem[]

  @@index([memberId])
  @@index([supportPartnerId])
  @@map("interactions")
}

model InteractionSummary {
  id            String                   @id @default(uuid())
  interactionId String                   @unique @map("interaction_id")
  content       String
  status        InteractionSummaryStatus @default(PENDING_APPROVAL)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  interaction Interaction @relation(fields: [interactionId], references: [id])

  @@map("interaction_summaries")
}

// "owner" is whoever is responsible for following through — almost always
// the Member ("Call PT clinic — owner: Alex"), modeled as a User so it can
// point at a Partner too if a future workflow needs that.
model ActionItem {
  id            String           @id @default(uuid())
  interactionId String           @map("interaction_id")
  memberId      String           @map("member_id")
  ownerId       String           @map("owner_id")
  description   String
  dueDate       DateTime?        @map("due_date")
  status        ActionItemStatus @default(PENDING_APPROVAL)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  interaction      Interaction       @relation(fields: [interactionId], references: [id])
  member           MemberProfile     @relation(fields: [memberId], references: [id])
  owner            User              @relation(fields: [ownerId], references: [id])
  reviewQueueItems ReviewQueueItem[]

  @@index([memberId])
  @@map("action_items")
}

// Append-only audit of every LLM call — full prompt + response, per the
// "full auditability... as the substitute for everything runs locally"
// principle in docs/plan.md. create()-only in the data layer; Sprint 8
// revokes UPDATE/DELETE at the DB role level alongside AuditLogEntry.
// interactionId is nullable because PREP_DIGEST calls happen on the Prep
// Card before any Interaction exists — memberId is always set instead, so
// every invocation is traceable to a Member regardless of purpose.
model AIInvocationLog {
  id            String              @id @default(uuid())
  interactionId String?             @map("interaction_id")
  memberId      String              @map("member_id")
  purpose       AIInvocationPurpose
  model         String
  promptText    String              @map("prompt_text")
  responseText  String              @map("response_text")
  createdAt     DateTime            @default(now()) @map("created_at")

  interaction Interaction?  @relation(fields: [interactionId], references: [id])
  member      MemberProfile @relation(fields: [memberId], references: [id])

  @@index([interactionId])
  @@index([memberId])
  @@map("ai_invocation_logs")
}

// Config-driven, per docs/plan.md — an org's own safety-keyword list is
// data managed at /admin/settings, never a hardcoded array in the rule
// engine. safetyKeywords.ts reads this table, nothing else.
model OrgSafetyKeyword {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  keyword   String
  severity  FlagSeverity
  createdAt DateTime     @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("org_safety_keywords")
}

enum FlagType {
  SAFETY_KEYWORD
  MISSED_FOLLOW_UP
  BOUNDARY_BREACH
  LLM_FLAGGED
}

enum FlagSource {
  RULE_ENGINE
  LLM
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// OPEN is the only status a flag can be created with — only a Lead's
// action in Sprint 6 (resolveReviewItem/escalateReviewItem) moves it to
// RESOLVED/ESCALATED. Surface (this sprint) only ever creates, never
// transitions, a ReviewQueueItem — the same "AI/automation proposes,
// human decides" boundary as everywhere else in the Continuity Engine.
model ReviewQueueItem {
  id             String            @id @default(uuid())
  memberId       String            @map("member_id")
  interactionId  String?           @map("interaction_id")
  actionItemId   String?           @map("action_item_id")
  flagType       FlagType          @map("flag_type")
  flagSource     FlagSource        @map("flag_source")
  severity       FlagSeverity
  rationale      String
  status         ReviewQueueStatus @default(OPEN)
  resolutionNote String?           @map("resolution_note")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  member      MemberProfile @relation(fields: [memberId], references: [id])
  interaction Interaction?  @relation(fields: [interactionId], references: [id])
  actionItem  ActionItem?   @relation(fields: [actionItemId], references: [id])

  @@index([memberId])
  @@index([status])
  @@map("review_queue_items")
}

enum ReviewQueueStatus {
  OPEN
  RESOLVED
  ESCALATED
}
